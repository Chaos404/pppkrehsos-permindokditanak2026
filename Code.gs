function getProvinces() {
  const seen = {};
  return DATA_WILAYAH.filter(row => {
    if (seen[row.provinceId]) return false;
    seen[row.provinceId] = true;
    return true;
  }).map(row => ({id: row.provinceId, name: row.province}));
}

function getRegencies(provinceId) {
  const id = String(provinceId || '').trim();
  if (!/^\d{2}$/.test(id)) throw new Error('ID provinsi tidak valid.');
  return DATA_WILAYAH.filter(row => row.provinceId === id)
    .map(row => ({id: row.code, name: row.regency, code: row.code}));
}

const CFG={spreadsheetId:'',folderId:'',spreadsheetName:'Database PPPK Rehabilitasi Sosial',folderName:'Lampiran PPPK Rehabilitasi Sosial'};
const HEADERS={
RESPON:['TIMESTAMP','ID_RESPON','SATKER_SDM','NAMA_LENGKAP','NIP','WHATSAPP','PROVINSI','KABUPATEN_KOTA','JUMLAH_ANAK','JUMLAH_LEMBAGA'],
DATA_ANAK:['TIMESTAMP','ID_RESPON','NAMA_ANAK','NIK_ANAK','NO_KK','JENIS_PPKS','STATUS_ABH','KOMPONEN_LAYANAN','BASIS_LAYANAN'],
DATA_LEMBAGA:['TIMESTAMP','ID_RESPON','NAMA_LEMBAGA','JENIS_LEMBAGA','ALAMAT','JUMLAH_ANAK_LAKI_LAKI','JUMLAH_ANAK_PEREMPUAN','LINK_BNBA','CATATAN','NO_KONTAK_WA','DESA_KELURAHAN','KECAMATAN','KABUPATEN_KOTA','PROVINSI','JUMLAH_ANAK_BINAAN']};
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('Pendataan PPPK Rehabilitasi Sosial').addMetaTag('viewport','width=device-width, initial-scale=1');}
function setupApp(){const ss=db_();Object.keys(HEADERS).forEach(n=>sheet_(ss,n));folder_();Logger.log('Spreadsheet: '+ss.getUrl());return {url:ss.getUrl()};}
function saveSubmission(p){
 validate_(p);const lock=LockService.getScriptLock();lock.waitLock(30000);
 try{const ss=db_();Object.keys(HEADERS).forEach(n=>sheet_(ss,n));const now=new Date(),id='PPPK-'+Utilities.formatDate(now,Session.getScriptTimeZone(),'yyyyMMdd-HHmmss')+'-'+Math.floor(1000+Math.random()*9000),folder=folder_();
 const institutions=p.institutions.map(x=>{let url='';if(x.file&&x.file.data){const blob=Utilities.newBlob(Utilities.base64Decode(x.file.data),x.file.mimeType||'application/octet-stream',safeFile_(x.file.name));url=folder.createFile(blob).getUrl();}return [now,id,cell_(x.name),'',cell_(x.address),num_(x.boys),num_(x.girls),url,cell_(x.notes),cell_(x.contact),cell_(x.village),cell_(x.district),cell_(x.regency),cell_(x.province),num_(x.total)];});
 const children=p.children.map(x=>[now,id,cell_(x.name),cell_(x.nik),cell_(x.kk),cell_(x.ppks),cell_(x.abhStatus),(x.services||[]).map(cell_).join('; '),cell_(x.basis)]);
 sheet_(ss,'RESPON').appendRow([now,id,cell_(p.identity.satker),cell_(p.identity.name),cell_(p.identity.nip),cell_(p.identity.whatsapp),cell_(p.identity.province),cell_(p.identity.regency),children.length,institutions.length]);
 if(children.length)append_(sheet_(ss,'DATA_ANAK'),children);if(institutions.length)append_(sheet_(ss,'DATA_LEMBAGA'),institutions);
 return {ok:true,id:id,message:'Data berhasil disimpan. Halaman akan kembali ke formulir utama.'};
 }finally{lock.releaseLock();}
}
function validate_(p){if(!p||!p.identity)throw Error('Identitas belum lengkap.');const i=p.identity;
 if(!i.satker||!i.name||!validNip_(i.nip)||!validWa_(i.whatsapp)||!i.province||!i.regency)throw Error('Lengkapi identitas. NIP harus 18 digit dengan tanggal lahir YYYYMMDD yang valid, dan nomor WhatsApp harus valid.');
 if(!p.children||!p.children.length)throw Error('Tambahkan minimal satu data anak.');
 p.children.forEach((x,n)=>{if(!x.name||!/^[0-9]{16}$/.test(String(x.nik||''))||!/^[0-9]{16}$/.test(String(x.kk||''))||!x.ppks||!x.basis)throw Error('Data anak '+(n+1)+' belum lengkap. NIK dan No. KK harus 16 digit.');if(x.ppks==='Anak yang Berhadapan dengan Hukum'&&!['Pelaku','Korban','Saksi'].includes(x.abhStatus))throw Error('Pilih status ABH pada anak '+(n+1)+'.');if(!x.services||!x.services.length)throw Error('Pilih komponen layanan pada anak '+(n+1)+'.');});
 if(!p.institutions||!p.institutions.length)throw Error('Tambahkan minimal satu lembaga.');
 p.institutions.forEach((x,n)=>{if(!x.name||!x.contact||!validWa_(x.contact)||!x.address||!x.village||!x.district||!x.regency||!x.province||!String(x.notes||'').trim())throw Error('Lengkapi seluruh kolom wajib pada lembaga '+(n+1)+', termasuk catatan.');if(!x.file||!x.file.data||!x.file.name)throw Error('File BNBA wajib diunggah untuk lembaga '+(n+1)+'.');if(!Number.isInteger(Number(x.boys))||!Number.isInteger(Number(x.girls))||!Number.isInteger(Number(x.total))||Number(x.boys)<0||Number(x.girls)<0||Number(x.total)<0)throw Error('Jumlah anak binaan lembaga '+(n+1)+' harus bilangan bulat nol atau lebih.');if(Number(x.total)!==Number(x.boys)+Number(x.girls))throw Error('Jumlah Anak Binaan pada lembaga '+(n+1)+' harus sama dengan jumlah laki-laki + perempuan.');if(x.file&&x.file.size>10*1024*1024)throw Error('Ukuran BNBA maksimal 10 MB.');});
}
function validNip_(v){v=String(v||'');if(!/^\d{18}$/.test(v))return false;const s=v.slice(0,8),y=+s.slice(0,4),m=+s.slice(4,6),d=+s.slice(6,8),dt=new Date(Date.UTC(y,m-1,d));return y>=1900&&dt.getUTCFullYear()===y&&dt.getUTCMonth()===m-1&&dt.getUTCDate()===d;}
function validWa_(v){let s=String(v||'').replace(/[\s().-]/g,'');if(s.startsWith('+'))s=s.slice(1);if(s.startsWith('0'))s='62'+s.slice(1);return /^62[1-9]\d{7,12}$/.test(s);}
function db_(){if(CFG.spreadsheetId)return SpreadsheetApp.openById(CFG.spreadsheetId);const pr=PropertiesService.getScriptProperties();let id=pr.getProperty('DB_ID');if(id){try{return SpreadsheetApp.openById(id)}catch(e){}}const s=SpreadsheetApp.create(CFG.spreadsheetName);pr.setProperty('DB_ID',s.getId());return s;}
function folder_(){if(CFG.folderId)return DriveApp.getFolderById(CFG.folderId);const pr=PropertiesService.getScriptProperties();let id=pr.getProperty('UPLOAD_FOLDER_ID');if(id){try{return DriveApp.getFolderById(id)}catch(e){}}const f=DriveApp.createFolder(CFG.folderName);pr.setProperty('UPLOAD_FOLDER_ID',f.getId());return f;}
function sheet_(ss,n){let sh=ss.getSheetByName(n);if(!sh)sh=ss.insertSheet(n);const h=HEADERS[n];if(!sh.getLastRow()){sh.getRange(1,1,1,h.length).setValues([h]).setFontWeight('bold').setBackground('#ccfbf1');sh.setFrozenRows(1);}else if(n==='DATA_LEMBAGA'&&sh.getLastColumn()<h.length){sh.getRange(1,1,1,h.length).setValues([h]).setFontWeight('bold').setBackground('#ccfbf1');sh.setFrozenRows(1);}return sh;}
function append_(sh,rows){sh.getRange(sh.getLastRow()+1,1,rows.length,rows[0].length).setValues(rows);}
function num_(v){const n=Number(v);return Number.isFinite(n)&&n>0?Math.floor(n):0;}
function cell_(v){const s=String(v==null?'':v).trim();return /^[=+\-@]/.test(s)?"'"+s:s;}
function safeFile_(n){return String(n||'lampiran').replace(/[\\/:*?"<>|#%{}~&]/g,'_').slice(0,150);}


function getPreviousByNip(nip){
  nip=String(nip||'').trim();
  if(!/^\d{18}$/.test(nip)) return {ok:false,message:'Masukkan NIP 18 digit untuk melihat data sebelumnya.',children:[],institutions:[]};
  const ss=db_();
  const responseSheet=sheet_(ss,'RESPON');
  const childSheet=sheet_(ss,'DATA_ANAK');
  const instSheet=sheet_(ss,'DATA_LEMBAGA');
  const responses=responseSheet.getDataRange().getValues();
  if(responses.length<2) return {ok:true,children:[],institutions:[],submissions:[]};
  const matching=responses.slice(1).filter(r=>String(r[4]||'').trim()===nip);
  if(!matching.length) return {ok:true,children:[],institutions:[],submissions:[]};
  const ids=new Set(matching.map(r=>String(r[1]||'')));
  const children=childSheet.getDataRange().getValues().slice(1)
    .filter(r=>ids.has(String(r[1]||'')))
    .map(r=>({id:String(r[1]||''),name:String(r[2]||''),nik:String(r[3]||''),kk:String(r[4]||''),ppks:String(r[5]||''),status:String(r[6]||''),services:String(r[7]||''),basis:String(r[8]||''),timestamp:r[0] instanceof Date?r[0].toISOString():String(r[0]||'')}));
  const institutions=instSheet.getDataRange().getValues().slice(1)
    .filter(r=>ids.has(String(r[1]||'')))
    .map(r=>({id:String(r[1]||''),name:String(r[2]||''),address:String(r[4]||''),boys:Number(r[5]||0),girls:Number(r[6]||0),bnbaUrl:'',notes:String(r[8]||''),contact:String(r[9]||''),village:String(r[10]||''),district:String(r[11]||''),regency:String(r[12]||''),province:String(r[13]||''),total:Number(r[14]||0),timestamp:r[0] instanceof Date?r[0].toISOString():String(r[0]||'')}));
  return {ok:true,children:children,institutions:institutions,submissions:matching.map(r=>({id:String(r[1]||''),date:r[0] instanceof Date?r[0].toISOString():String(r[0]||''),name:String(r[3]||''),province:String(r[6]||''),regency:String(r[7]||'')}))};
}
